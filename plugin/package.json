{
  "name": "agentguard-agentia-plugin",
  "description": "Behavioural quality gate for Agentforce agents",
  "version": "0.1.0",
  "author": "AgentGuard",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": "./dist/index.js",
  "license": "MIT",
  "keywords": [
    "oclif-plugin",
    "agentia"
  ],
  "files": [
    "/dist",
    "/oclif.manifest.json"
  ],
  "dependencies": {
    "@copado/agentia-plugin-sdk": "^0.1.1",
    "agentguard": "file:.."
  },
  "peerDependencies": {
    "@oclif/core": "^4"
  },
  "devDependencies": {
    "@oclif/core": "^4",
    "@types/node": "^22",
    "oclif": "^4",
    "shx": "^0.3.3",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "agentia": {
    "hostApi": 1,
    "requires": [
      "format.table",
      "work.getWorkItem"
    ],
    "permissions": {
      "network": [],
      "files": "none",
      "commands": [
        "sf",
        "git"
      ],
      "env": []
    }
  },
  "oclif": {
    "bin": "agentia",
    "dirname": "agentia-cli",
    "commands": "./dist/commands",
    "topics": {
      "agentguard": {
        "description": "AgentGuard behavioural quality gates for Agentforce agents"
      }
    }
  },
  "scripts": {
    "build": "shx rm -rf dist && tsc -b",
    "clean": "shx rm -f oclif.manifest.json",
    "prepack": "npm run build && oclif manifest",
    "postpack": "npm run clean"
  }
}